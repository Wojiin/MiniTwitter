{# modal #}
<div id="popup-modal" tabindex="-1" class="modal-overlay">
	<div class="modal-card">
		<div class="modal-header">
			<div>
				<h2 class="modal-title">Confirmation suppression</h2>
				<p class="modal-subtitle">Cette action est definitive.</p>
			</div>
			<button type="button" class="modal-close" data-modal-hide="popup-modal">
				<svg class="h-5 w-5" aria-hidden="true" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M18 18 6 6"/></svg>
			</button>
		</div>

		<div class="modal-body">
			<div class="modal-icon">
				<svg class="h-7 w-7" aria-hidden="true" width="24" height="24" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86l-7.5 13A1 1 0 0 0 3.66 18h16.68a1 1 0 0 0 .87-1.49l-7.5-13a1 1 0 0 0-1.74 0Z"/></svg>
			</div>

			<p class="modal-message">
				Confirmer la suppression
			</p>
		</div>

		<div class="modal-actions">
			<button data-modal-hide="popup-modal" type="button" class="modal-button-secondary">
				Non
			</button>
			<button id="oui" data-modal-hide="popup-modal" type="button" class="modal-button-danger">
				Oui
			</button>
		</div>
	</div>
</div>
