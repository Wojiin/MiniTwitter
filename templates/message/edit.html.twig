{% extends 'base.html.twig' %}

{% block title %}Modification Message{% endblock %}

{% block body %}
    <h1>Modifier un message</h1>

    {{ include('message/_form.html.twig', {'button_label': 'Update'}) }}

    {% if message.discussion %}
        <a href="{{ path('app_discussion_show', {'id': message.discussion.id}) }}">Retourner à la discussion</a>
    {% endif %}
{% endblock %}
