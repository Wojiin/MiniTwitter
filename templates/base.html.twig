	<body style="background-color: var(--color-neutral-50);">
		{{ include('layout/_nav.html.twig') }}
		{% block page_layout %}
			<div class="page-shell">
				{% block sidebar_left %}
					{{ include('layout/_sidebar_left.html.twig') }}
				{% endblock %}
				<main class="page-content">
					{% block flash %}
						{% for message in app.flashes('error') %}
							<div class="alert alert-danger">{{ message }}</div>
						{% endfor %}
						{% for message in app.flashes('succes') %}
							<div class="succes">{{ message }}</div>
						{% endfor %}
					{% endblock %}
					{% block body %}{% endblock %}
				</main>
				{% block sidebar_right %}
					{{ include('layout/_sidebar_right.html.twig') }}
				{% endblock %}
			</div>
