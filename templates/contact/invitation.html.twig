{% extends 'base.html.twig' %}

{% block title %}Liste des invitations
{% endblock %}

{% block body %}
	<div class="page-stack-wide">
		<h1 class="section-title-lg">Liste des invitations</h1>

		{% if contacts|length > 0 %}
			<div class="table-shell">
				<table class="table">
					<thead>
						<tr>
							<th>Invitation</th>
							<th>Decision</th>
						</tr>
					</thead>
					<tbody>
						{% for contact in contacts %}
							<tr>
								<td>{{ contact.sender.userName }} vous a envoye une demande d'invitation</td>
								<td class="table-actions">
									<form action="{{ path('app_contact_invitation_accept', {'id': contact.id}) }}" method="post">
    									<button type="submit" class="btn-soft-emerald">Oui</button>
									</form>
									<form action="{{ path('app_contact_invitation_refuse', {'id': contact.id}) }}" method="post">
    									<button type="submit" class="btn-soft-rose">Non</button>
									</form>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% else %}
			<p class="muted-text">aucune invitation en attente</p>
		{% endif %}
	</div>
{% endblock %}
