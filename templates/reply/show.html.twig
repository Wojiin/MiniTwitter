{% extends 'base.html.twig' %}

{% block title %}Reply{% endblock %}

{% block body %}
    <h1>Reply</h1>

    <table class="table">
        <tbody>
            <tr>
                {# <th>Id</th>
                <td>{{ reply.id }}</td> #}
            </tr>
            <tr>
                <th>Content</th>
                <td>{{ reply.content }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>
                    {% if reply.image %}
                        <img src="{{ asset('uploads/replies/' ~ reply.image) }}" alt="Image de la reponse {{ reply.id }}" style="max-width: 250px; max-height: 250px;">
                    {% else %}
                        Aucune image
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ reply.createdAt ? reply.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Updated_at</th>
                <td>{{ reply.updatedAt ? reply.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ reply.status }}</td>
            </tr>
            <tr>
                <th>Count_flag</th>
                <td>{{ reply.countFlag }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_reply_index') }}">back to list</a>

    <a href="{{ path('app_reply_edit', {'id': reply.id}) }}">edit</a>

    {{ include('reply/_delete_form.html.twig') }}
{% endblock %}
