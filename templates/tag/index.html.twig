{% extends 'base.html.twig' %}

{% block title %}Tag index{% endblock %}

{% block body %}
    <div class="page-stack-wide">
        <h1 class="section-title-lg">Tags</h1>

        <div class="table-shell">
            <table class="table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for tag in tags %}
                    <tr>
                        <td>{{ tag.category }}</td>
                        <td class="table-actions">
                            <a class="table-link" href="{{ path('app_tag_show', {'id': tag.id}) }}">show</a>
                            <a class="table-link" href="{{ path('app_tag_edit', {'id': tag.id}) }}">edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2" class="table-empty">no records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <a class="btn-primary" href="{{ path('app_tag_new') }}">Create new</a>
    </div>
{% endblock %}
