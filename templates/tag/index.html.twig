{% extends 'base.html.twig' %}

{% block title %}Liste des Tags{% endblock %}

{% block body %}
    <h1>Liste des Tags</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Categorie</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for tag in tags %}
            <tr>
                <td>{{ tag.category }}</td>
                <td>
                    <a href="{{ path('app_tag_show', {'id': tag.id}) }}">Détail</a>
                    <a href="{{ path('app_tag_edit', {'id': tag.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucuns tags présents</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_tag_new') }}">Créer un nouveau tag</a>
{% endblock %}
