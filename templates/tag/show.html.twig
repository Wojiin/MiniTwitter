{% extends 'base.html.twig' %}

{% block title %}Tag{% endblock %}

{% block body %}
    <h1>Tag</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Categorie</th>
                <td>{{ tag.category }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_tag_index') }}">Retur à la liste des tags</a>

    <a href="{{ path('app_tag_edit', {'id': tag.id}) }}">Modifier</a>

    {{ include('tag/_delete_form.html.twig') }}
    {% include "_modal.html.twig" %}
{% endblock %}
