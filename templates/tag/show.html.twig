{% extends 'base.html.twig' %}

{% block title %}Tag{% endblock %}

{% block body %}
    <div class="page-stack">
        <h1 class="section-title-lg">Tag</h1>

        <div class="table-shell">
            <table class="table">
                <tbody>
                    <tr>
                        <th>Categorie</th>
                        <td>{{ tag.category }}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="action-grid">
            <a class="table-link" href="{{ path('app_tag_index') }}">Retour à la liste des tags</a>
            <a class="table-link" href="{{ path('app_tag_edit', {'id': tag.id}) }}">Modifier</a>
            {{ include('tag/_delete_form.html.twig') }}
        </div>
    </div>
    {% include "_modal.html.twig" %}
{% endblock %}
