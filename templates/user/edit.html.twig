{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
    <h1 class="section-title-lg">Modification d'un utilisateur</h1>

    <p>
        En tant qu'administrateur, vous pouvez passer un compte en <strong>actif</strong>,
        <strong>suspendu</strong> ou <strong>banni</strong>. Remettre le statut a
        <strong>actif</strong> leve la suspension ou le bannissement.
    </p>

    {{ include('user/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

    <a class="table-link" href="{{ path('app_user_index') }}">Retour à la liste des utilisateurs</a>

    {{ include('user/_delete_form.html.twig') }}
{% endblock %}
