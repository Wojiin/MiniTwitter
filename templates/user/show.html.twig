{% extends 'base.html.twig' %}

{% block title %}User
{% endblock %}

{% block body %}
	<h1>Details de l'utilisateur</h1>

	{% if user.profilPicture %}
		<p>Photo de profil :
			<img src="{{ asset('uploads/profile_pictures/' ~ user.profilPicture) }}" alt="Photo de profil de {{ user.userName }}" style="max-width: 120px; max-height: 120px;">
		</p>
	{% endif %}

	<ul>
		<h2>Infos</h2>
		<li>Email :
			{{ user.email }}</li>
		<li>Nom d'utilisateur :
			{{ user.userName }}</li>
		<li>Statut :
			{{ user.status }}</li>
		<li>Fin de suspension :
			{{ user.suspendedUntil ? user.suspendedUntil|date('d/m/Y H:i') : 'Aucune' }}</li>
		<li>Nombre de signalements :
			{{ user.countFlag }}</li>
		<li>Compte cree le :
			{{ user.createdAt|date('d/m/Y H:i') }}</li>
	</ul>

	<ul>
		<h2>Gazouillis</h2>

		{% for post in user.posts %}
			{% if post.status !== "supprime" %}
				<li>
					<a href="{{ path('app_post_show', {id: post.id}) }}">{{ post.title }}</a>
				</li>
			{% endif %}
		{% else %}
			<li>Aucun gazouillis pour le moment.</li>

		{% endfor %}

	</ul>

	<ul>
		<h2>Reposts</h2>
		{% for repost in user.repost %}
			{% if repost.status !== "supprime" %}
				<li>
					<a href="{{ path('app_post_show', {id: repost.id}) }}">{{ repost.title }}</a>
				</li>
			{% else %}
				<li>Repost d'un post supprimé</li>
			{% endif %}

		{% else %}
			<li>Aucun repost pour le moment.</li>
		{% endfor %}
	</ul>

	<a href="{{ path('app_user_index') }}">retour à la liste des utilisateurs</a>

	{% if app.user and app.user.id != user.id %}
		{% if user not in app.user.flagUser %}
			<form action="{{ path('app_user_addflag', {'id': user.id}) }}" method="post">
				<input name="flag" id="flag" value="signaler" type="submit">
			</form>
		{% else %}
			<form action="{{ path('app_user_unflag', {'id': user.id}) }}" method="post">
				<input name="unflag" id="unflag" value="retirer le signalement" type="submit">
			</form>
		{% endif %}
	{% endif %}

	{% if is_granted('ROLE_ADMIN') %}
		<a href="{{ path('app_user_edit', {'id': user.id}) }}">modifier</a>
		{{ include('user/_delete_form.html.twig') }}
	{% endif %}
	{% include "_modal.html.twig" %}
{% endblock %}
