{% extends 'base.html.twig' %}

{% block title %}User
{% endblock %}

{% block body %}
	<h1>Détails de l'utilisateur</h1>
	
		{% if user.profilPicture %}
        <p>Photo de profil :
			<img src="{{ asset('uploads/profile_pictures/' ~ user.profilPicture) }}" alt="Photo de profil de {{ user.userName }}" style="max-width: 120px; max-height: 120px;">
			</p>
		{% endif %}

	<ul>
		<h2>Infos</h2>
		<li>Email :
			{{ user.email }}</li>
		<li>Nom d'utilisateur :
			{{ user.userName }}</li>
		<li>Statut :
			{{ user.status }}</li>
		<li>Compte cree le :
			{{ user.createdAt|date('d/m/Y H:i') }}</li>
	</ul>

	<ul>
		<h2>Gazouillis</h2>
		{% for post in user.posts %}
			<li>
				<a href="{{ path('app_post_show', {id: post.id}) }}">{{ post.title }}</a>
			</li>
		{% else %}
			<li>Aucun gazouillis pour le moment.</li>
		{% endfor %}
	</ul>

	<a href="{{ path('app_user_index') }}">back to list</a>

	{% if is_granted('ROLE_ADMIN') or (app.user and app.user.id == user.id) %}
		<a href="{{ path('app_user_edit', {'id': user.id}) }}">edit</a>
		{{ include('user/_delete_form.html.twig') }}
	{% endif %}
{% endblock %}
