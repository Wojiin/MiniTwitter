{% extends 'base.html.twig' %}

{% block title %}User index
{% endblock %}

{% block body %}
	<h1>Liste des utilisateurs</h1>

	{% if is_granted('ROLE_ADMIN') %}
		<h2>Utilisateurs signales</h2>

		{% set has_flagged_users = false %}
		{% for user in users %}
			{% if user.countFlag > 0 %}
				{% set has_flagged_users = true %}
			{% endif %}
		{% endfor %}

		{% if has_flagged_users %}
			<table class="table">
				<thead>
					<tr>
						<th>Id</th>
						<th>Email</th>
						<th>Nom d'utilisateur</th>
						<th>Statut</th>
						<th>Compteur de flags</th>
						<th>actions</th>
					</tr>
				</thead>
				<tbody>
					{% for user in users %}
						{% if user.countFlag > 0 %}
							<tr>
								<td>{{ user.id }}</td>
								<td>{{ user.email }}</td>
								<td>{{ user.userName }}</td>
								<td>{{ user.status }}</td>
								<td>{{ user.countFlag }}</td>
								<td>
									<a href="{{ path('app_user_show', {'id': user.id}) }}">show</a>
									<a href="{{ path('app_user_edit', {'id': user.id}) }}">edit</a>
								</td>
							</tr>
						{% endif %}
					{% endfor %}
				</tbody>
			</table>
		{% else %}
			<p>aucun utilisateur n'a de signalement</p>
		{% endif %}
	{% endif %}

	<table class="table">
		<thead>
			<tr>
				<th>Photo de profil</th>
				<th>Nom d'utilisateur</th>
				<th>Email</th>
				<th>Statut</th>
				<th>Role</th>
				<th>Actions</th>
				<th>Demande</th>
			</tr>
		</thead>
		<tbody>
			{% for user in users %}
				<tr>
					<td>
						{% if user.profilPicture %}
							<img src="{{ asset('uploads/profile_pictures/' ~ user.profilPicture) }}" alt="Photo de profil de {{ user.userName }}" style="max-width: 80px; max-height: 80px;">
						{% else %}
							Aucune
						{% endif %}
					</td>
					<td>{{ user.userName }}</td>
					<td>{{ user.email }}</td>
					<td>{{ user.status }}</td>
					<td>
						{% if 'ROLE_ADMIN' in user.roles %}
							ADMIN
						{% else %}
							User
						{% endif %}
					</td>
					<td>
						<a href="{{ path('app_user_show', {'id': user.id}) }}">details</a>
					</td>
					<td>
					{% set alreadyContact = false %}
					{% set contactStatus = null %}
					{% set existingContact = null %}
					{% for contact in contacts %}
					{% if contact.receiver === user %}
						{% set alreadyContact = true %}
						{% set contactStatus = contact.status %}
						{% set existingContact = contact %}
					{% endif %}
{% endfor %}
{% if not alreadyContact and user != app.user %}
					<form action="{{ path('app_contact_new', {'id': user.id}) }}" method="post">
    <button class="btn-primary" type="submit">Ajouter au contact</button>
</form>
{% elseif contactStatus == 'pending' and user != app.user %}
<form action="{{ path('app_contact_delete', {'id': existingContact.id}) }}" method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ existingContact.id) }}">
    <button class="btn-primary" type="submit">Annuler la demande</button>
</form>
{% endif %}
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="6">aucun utilisateur enregistré</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
