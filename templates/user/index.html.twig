{% extends 'base.html.twig' %}

{% block title %}User index
{% endblock %}

{% block body %}
	<h1>User index</h1>

	{% if is_granted('ROLE_ADMIN') %}
		<h2>Utilisateurs signales</h2>

		{% set has_flagged_users = false %}
		{% for user in users %}
			{% if user.countFlag > 0 %}
				{% set has_flagged_users = true %}
			{% endif %}
		{% endfor %}

		{% if has_flagged_users %}
			<table class="table">
				<thead>
					<tr>
						<th>Id</th>
						<th>Email</th>
						<th>Nom d'utilisateur</th>
						<th>Statut</th>
						<th>Compteur de flags</th>
						<th>actions</th>
					</tr>
				</thead>
				<tbody>
					{% for user in users %}
						{% if user.countFlag > 0 %}
							<tr>
								<td>{{ user.id }}</td>
								<td>{{ user.email }}</td>
								<td>{{ user.userName }}</td>
								<td>{{ user.status }}</td>
								<td>{{ user.countFlag }}</td>
								<td>
									<a href="{{ path('app_user_show', {'id': user.id}) }}">show</a>
									<a href="{{ path('app_user_edit', {'id': user.id}) }}">edit</a>
								</td>
							</tr>
						{% endif %}
					{% endfor %}
				</tbody>
			</table>
		{% else %}
			<p>aucun utilisateur n'a de signalement</p>
		{% endif %}
	{% endif %}

	<table class="table">
		<thead>
			<tr>
				<th>Photo de profil</th>
				<th>Nom d'utilisateur</th>
				<th>Email</th>
				<th>Statut</th>
				<th>Role</th>
				<th>Actions</th>
				<th>Demande</th>
			</tr>
		</thead>
		<tbody>
			{% for user in users %}
				<tr>
					<td>
						{% if user.profilPicture %}
							<img src="{{ asset('uploads/profile_pictures/' ~ user.profilPicture) }}" alt="Photo de profil de {{ user.userName }}" style="max-width: 80px; max-height: 80px;">
						{% else %}
							Aucune
						{% endif %}
					</td>
					<td>{{ user.userName }}</td>
					<td>{{ user.email }}</td>
					<td>{{ user.status }}</td>
					<td>
						{% if 'ROLE_ADMIN' in user.roles %}
							ADMIN
						{% else %}
							User
						{% endif %}
					</td>
					<td>
						<a href="{{ path('app_user_show', {'id': user.id}) }}">details</a>
						<button type="button" commandfor="mydialog" command="show-modal" data-user-id="{{ user.id }}" data-user-name="{{ user.userName }}" class="btn-add-contact">Ajouter au contact</button>
						<dialog id="mydialog">
							<div class="wrapper">
								<form>
									<fieldset>
										<legend>
											Souhaitez-vous ajouter {{ user.userName }} à votre liste de contact ?
										</legend>
										<div>
											<button type="checkbox" id="no" name="close" value="no" checked/>
											<label for="no">Oui</label>
										</div>
										<div>
											<button type="checkbox" id="yes" name="close" value="yes"/>
											<label for="yes">Non</label>
										</div>
									</fieldset>
								</form>
								<button commandfor="mydialog" command="request-close">
									Fermer le fenêtre
								</button>
								<p class="warning" hidden>
									Vous devez choisir «&nbsp;Oui&nbsp;» pour fermer cette boîte de dialogue.
								</p>
							</div>
						</dialog>
						{% if is_granted('ROLE_ADMIN') %}
							<a href="{{ path('app_user_edit', {'id': user.id}) }}">modifier</a>
						{% endif %}
					</td>
					<td>
						<button type="button" commandfor="mydialog" command="show-modal">En cours</button>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="6">aucun utilisateur enregistré</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
