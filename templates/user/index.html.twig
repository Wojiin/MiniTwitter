{% extends 'base.html.twig' %}

{% block title %}User index
{% endblock %}

{% block body %}
	<h1>User index</h1>

	{% if is_granted('ROLE_ADMIN') %}
		<h2>Utilisateurs signales</h2>

		{% set has_flagged_users = false %}
		{% for user in users %}
			{% if user.countFlag > 0 %}
				{% set has_flagged_users = true %}
			{% endif %}
		{% endfor %}

		{% if has_flagged_users %}
			<table class="table">
				<thead>
					<tr>
						<th>Id</th>
						<th>Email</th>
						<th>Nom d'utilisateur</th>
						<th>Statut</th>
						<th>Compteur de flags</th>
						<th>actions</th>
					</tr>
				</thead>
				<tbody>
				{% for user in users %}
					{% if user.countFlag > 0 %}
						<tr>
							<td>{{ user.id }}</td>
							<td>{{ user.email }}</td>
							<td>{{ user.userName }}</td>
							<td>{{ user.status }}</td>
							<td>{{ user.countFlag }}</td>
							<td>
								<a href="{{ path('app_user_show', {'id': user.id}) }}">show</a>
								<a href="{{ path('app_user_edit', {'id': user.id}) }}">edit</a>
							</td>
						</tr>
					{% endif %}
				{% endfor %}
				</tbody>
			</table>
		{% else %}
			<p>aucun utilisateur n'a de flag</p>
		{% endif %}
	{% endif %}

	<table class="table">
		<thead>
			<tr>
				<th>Photo de profil</th>
				<th>Nom d'utilisateur</th>
				<th>Email</th>
				<th>Statut</th>
				<th>Role</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			{% for user in users %}
				<tr>
					<td>
						{% if user.profilPicture %}
							<img src="{{ asset('uploads/profile_pictures/' ~ user.profilPicture) }}" alt="Photo de profil de {{ user.userName }}" style="max-width: 80px; max-height: 80px;">
						{% else %}
							Aucune
						{% endif %}
					</td>
					<td>{{ user.userName }}</td>
					<td>{{ user.email }}</td>
					<td>{{ user.status }}</td>
					<td>{{ user.roles ? user.roles|json_encode : '' }}</td>
					<td>
						<a href="{{ path('app_user_show', {'id': user.id}) }}">details</a>
						{% if is_granted('ROLE_ADMIN') %}
							<a href="{{ path('app_user_edit', {'id': user.id}) }}">edit</a>
						{% endif %}
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="6">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
{% endblock %}
