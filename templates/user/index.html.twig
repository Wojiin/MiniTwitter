{% extends 'base.html.twig' %}

{% block title %}User index
{% endblock %}

{% block body %}
	<h1>User index</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Photo de profil</th>
				<th>Nom d'utilisateur</th>
				<th>Email</th>
				<th>Statut</th>
				<th>Role</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			{% for user in users %}
				<tr>
					<td>
						{% if user.profilPicture %}
							<img src="{{ asset('uploads/profile_pictures/' ~ user.profilPicture) }}" alt="Photo de profil de {{ user.userName }}" style="max-width: 80px; max-height: 80px;">
						{% else %}
							Aucune
						{% endif %}
					</td>
					<td>{{ user.userName }}</td>
					<td>{{ user.email }}</td>
					<td>{{ user.status }}</td>
					<td>{{ user.roles ? user.roles|json_encode : '' }}</td>
					<td>
						<a href="{{ path('app_user_show', {'id': user.id}) }}">details</a>
						{% if is_granted('ROLE_ADMIN') or (app.user and app.user.id == user.id) %}
							<a href="{{ path('app_user_edit', {'id': user.id}) }}">edit</a>
						{% endif %}
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="13">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

{% endblock %}
