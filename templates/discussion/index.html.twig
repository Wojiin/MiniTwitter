{% extends 'base.html.twig' %}

{% block title %}Liste des discussions{% endblock %}

{% block body %}
    <h1>Liste des discussions</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Created_at</th>
                <th>Updated_at</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for discussion in discussions %}
            <tr>
                <td>{{ discussion.title }}</td>
                <td>{{ discussion.createdAt ? discussion.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ discussion.updatedAt ? discussion.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_discussion_show', {'id': discussion.id}) }}">Détail</a>
                    <a href="{{ path('app_discussion_edit', {'id': discussion.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucune discussion existante</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_discussion_new') }}">Créer une nouvelle discussion</a>
{% endblock %}
