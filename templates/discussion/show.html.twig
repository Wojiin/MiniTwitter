{% extends 'base.html.twig' %}

{% block title %}Discussion{% endblock %}

{% block body %}
    <div class="discussion-layout xl:grid-cols-[22rem_minmax(0,_1fr)]">

        <aside class="discussion-sidebar-panel">
            <div class="discussion-panel-header">
                <h2 class="discussion-panel-title">Discussions</h2>
                <a href="{{ path('app_discussion_new') }}" class="discussion-icon-button" title="Nouvelle discussion">+</a>
            </div>

            <div class="discussion-search">
                <input type="text" placeholder="Rechercher une discussion" class="discussion-search-input">
            </div>

            <div class="discussion-list">
                {% for item in discussions %}
                    {% set latestMessage = item.messages|last %}
                    <a href="{{ path('app_discussion_show', {'id': item.id}) }}" class="discussion-item {{ item.id == discussion.id ? 'discussion-item-active' : '' }}">
                        <div class="profile-avatar">
                            {% set avatarUser = null %}
                            {% for participant in item.discuss %}
                                {% if app.user and participant.id != app.user.id %}
                                    {% set avatarUser = participant %}
                                {% endif %}
                            {% endfor %}
                            {% if avatarUser and avatarUser.profilPicture %}
                                <img src="{{ asset('uploads/profile_pictures/' ~ avatarUser.profilPicture) }}" alt="Photo de profil de {{ avatarUser.userName }}" class="profile-avatar-image">
                            {% else %}
                                {{ (avatarUser ? avatarUser.userName : item.title)|first|upper }}
                            {% endif %}
                        </div>
                        <div class="discussion-item-copy">
                            <div class="flex items-center justify-between gap-2">
                                <h3 class="discussion-item-title">{{ item.title }}</h3>
                                <span class="discussion-item-meta">{{ item.updatedAt ? item.updatedAt|date('d/m H:i') : '' }}</span>
                            </div>
                            <p class="discussion-item-preview">
                                {% if latestMessage %}
                                    {{ latestMessage.content }}
                                {% else %}
                                    Aucun message pour le moment.
                                {% endif %}
                            </p>
                        </div>
                    </a>
                {% else %}
                    <p class="table-empty">Aucune discussion disponible.</p>
                {% endfor %}
            </div>

            <div class="discussion-side-section">
                <h3 class="reply-section-title">Participants</h3>
                <ul class="discussion-participant-list">
                    {% for participant in participants %}
                        <li class="discussion-participant-item">
                            <div class="profile-avatar !h-9 !w-9 overflow-hidden">
                                {% if participant.profilPicture %}
                                    <img src="{{ asset('uploads/profile_pictures/' ~ participant.profilPicture) }}" alt="Photo de profil de {{ participant.userName }}" class="profile-avatar-image">
                                {% else %}
                                    {{ participant.userName|first|upper }}
                                {% endif %}
                            </div>
                            <span>{{ participant.userName }}</span>
                        </li>
                    {% else %}
                        <li class="muted-text">Aucun participant</li>
                    {% endfor %}
                </ul>
            </div>

            <div class="discussion-side-section">
                {{ form_start(participants_form, {'attr': {'class': 'form-stack'}}) }}
                    {{ form_row(participants_form.participants) }}
                    <div class="table-actions">
                        <button class="btn-primary" type="submit">Ajouter</button>
                    </div>
                {{ form_end(participants_form) }}
            </div>

            <div class="discussion-side-section">
                <form method="post" action="{{ path('app_discussion_leave', {'id': discussion.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('leave' ~ discussion.id) }}">
                    <button class="btn-danger" type="submit">Quitter la discussion</button>
                </form>
            </div>
        </aside>

        <section class="discussion-main-panel">
            <header class="discussion-chat-header">
                <div class="profile-avatar overflow-hidden">
                    {% set headerUser = null %}
                    {% for participant in participants %}
                        {% if app.user and participant.id != app.user.id %}
                            {% set headerUser = participant %}
                        {% endif %}
                    {% endfor %}
                    {% if headerUser and headerUser.profilPicture %}
                        <img src="{{ asset('uploads/profile_pictures/' ~ headerUser.profilPicture) }}" alt="Photo de profil de {{ headerUser.userName }}" class="profile-avatar-image">
                    {% else %}
                        {{ (headerUser ? headerUser.userName : discussion.title)|first|upper }}
                    {% endif %}
                </div>
                <div>
                    <h1 class="section-title">{{ discussion.title }}</h1>
                    <p class="discussion-chat-meta">
                        {{ participants|length }} participant{{ participants|length > 1 ? 's' : '' }} · mise a jour {{ discussion.updatedAt ? discussion.updatedAt|date('d/m/Y H:i') : (discussion.createdAt ? discussion.createdAt|date('d/m/Y H:i') : '') }}
                    </p>
                </div>
                <div class="ml-auto discussion-header-actions">
                    <a href="{{ path('app_discussion_edit', {'id': discussion.id}) }}" class="discussion-icon-button" title="Modifier">M</a>
                    <a href="{{ path('app_discussion_index') }}" class="discussion-icon-button" title="Retour">R</a>
                </div>
            </header>

            <div class="discussion-chat-body">
                <div class="discussion-thread">
                    {% for message in messages %}
                        {% set isOwnMessage = app.user and message.send and app.user.id == message.send.id %}
                        <article class="discussion-message-row {{ isOwnMessage ? 'discussion-message-row-own' : '' }}">
                            {% if not isOwnMessage %}
                                {% if message.send and message.send.profilPicture %}
                                    <img src="{{ asset('uploads/profile_pictures/' ~ message.send.profilPicture) }}" alt="Photo de profil de {{ message.send.userName }}" class="discussion-message-avatar">
                                {% else %}
                                    <div class="profile-avatar !h-8 !w-8 text-xs">
                                        {{ message.send.userName|first|upper }}
                                    </div>
                                {% endif %}
                            {% endif %}

                            <div class="discussion-message-stack {{ isOwnMessage ? 'discussion-message-stack-own' : '' }}">
                                <div class="discussion-message-bubble {{ isOwnMessage ? 'discussion-message-bubble-own' : '' }}">
                                    <p class="reply-meta mb-2">
                                        <strong class="{{ isOwnMessage ? 'text-white' : 'text-gray-900' }}">{{ message.send.userName }}</strong>
                                    </p>
                                    <p class="discussion-message-text">{{ message.content }}</p>

                                    {% if message.picture %}
                                        <div class="mt-3">
                                            <img src="{{ asset('uploads/messages/' ~ message.picture) }}" alt="Image du message" class="message-image">
                                        </div>
                                    {% endif %}
                                </div>

                                <p class="discussion-message-time">
                                    {{ message.createdAt ? message.createdAt|date('H:i') : '' }}
                                </p>

                                {% if isOwnMessage %}
                                    <div class="discussion-message-actions discussion-message-actions-own">
                                        <a class="simple-link" href="{{ path('app_message_edit', {'id': message.id}) }}">Modifier</a>
                                    </div>
                                {% endif %}
                            </div>

                            {% if isOwnMessage %}
                                {% if app.user and app.user.profilPicture %}
                                    <img src="{{ asset('uploads/profile_pictures/' ~ app.user.profilPicture) }}" alt="Photo de profil de {{ app.user.userName }}" class="discussion-message-avatar">
                                {% else %}
                                    <div class="profile-avatar !h-8 !w-8 text-xs">
                                        {{ app.user.userName|first|upper }}
                                    </div>
                                {% endif %}
                            {% endif %}
                        </article>
                    {% else %}
                        <p class="muted-text">Aucun message pour le moment.</p>
                    {% endfor %}
                </div>
            </div>

            <div class="discussion-compose">
                {{ form_start(message_form, {'attr': {'class': 'discussion-compose-form'}}) }}
                    <div class="discussion-compose-row">
                        {{ form_widget(message_form.content, {
                            attr: {
                                class: 'discussion-compose-input',
                                placeholder: 'Message...',
                                rows: 1
                            }
                        }) }}
                        <button class="discussion-compose-submit" type="submit">></button>
                    </div>
                    <div>
                        {{ form_widget(message_form.picture, {
                            attr: {
                                class: 'form-file'
                            }
                        }) }}
                        {{ form_errors(message_form.content) }}
                        {{ form_errors(message_form.picture) }}
                    </div>
                {{ form_end(message_form) }}
            </div>
        </section>

        <a class="simple-link" href="{{ path('app_discussion_index') }}">Retour a la liste des discussions</a>
    </div>
{% endblock %}
