<form id="suppr" method="post" action="{{ path('app_post_delete', {'id': post.id}) }}" class="w-full">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
    <button class="btn-danger w-full" data-modal-toggle="popup-modal" data-modal-target="popup-modal" type="submit">Supprimer</button>
</form>
