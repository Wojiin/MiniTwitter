<form id="suppr{{post.id}}" method="post" action="{{ path('app_post_delete', {'id': post.id}) }}" class="w-full suppr">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
    <button type="button" data-modal-toggle="popup-modal" data-modal-target="popup-modal" class="btn-soft-violet">Supprimer</button>
</form>
