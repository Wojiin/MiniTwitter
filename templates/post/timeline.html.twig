{% extends 'base.html.twig' %}

{% block title %}Timeline
{% endblock %}

{% block body %}
	<h1>Fil d'actualité :</h1>
	<a href="{{ path('app_post_new') }}">Créer un nouveau post</a>
	<section>
		{% for post in posts |reverse %}
			<article>
				<h2>{{ post.title }}</h2>
				<p>Créé le :
					{{ post.createdAt ? post.createdAt|date('Y-m-d H:i:s') : '' }}
					par :
					{{ post.author }}</p>
				<p>{{ post.content }}</p>

				<p>
					{% if post.image %}
						<img src="{{ asset('uploads/posts/' ~ post.image) }}" alt="Image du post {{ post.title }}" style="max-width: 250px; max-height: 250px;">
					{% endif %}
				</p>
				{% if post.idCitation !== null %}
					<div>
						<h3>Ce post inclus la citation du post numéro
							{{post.idCitation.id}}</h3>
						<p>Post créé le :
							{{ post.idCitation.createdAt ? post.idCitation.createdAt|date('Y-m-d H:i:s') : '' }}
							par :
							{{ post.idCitation.author }}</p>
						<p>Contenu : {{ post.idCitation.content }}</p>
					</div>
				{% endif %}
				<tr>
					<td>Nombre de "j'aime" :
						{{ post.countLike }}
					</td>
					<td>
						{% if app.user and post not in app.user.likes %}
							<form action={{ path('app_post_addlike', {'id': post.id} )}} method="post">
								<input name="like" id="like" value="J'aime" type="submit">
							</form>
						{% else %}
							<form action={{ path('app_post_remlike', {'id': post.id} )}} method="post">
								<input name="unlike" id="unlike" value="Je n'aime plus" type="submit">
							</form>
						{% endif %}
					</td>
					{% if post.tags|length > 0  %}
						<td>Catégories :
							{% for tag in post.tags %}
								{{tag.category}}
							{% endfor %}
						</td>
					{% endif %}

					<td>Nombre de repost :
						{{ post.countRepost }}
					</td>
					<td>
						{% if app.user and post not in app.user.repost %}
							<form action={{ path('app_post_addrepost', {'id': post.id} )}} method="post">
								<input name="repost" id="repost" value="repost" type="submit">
							</form>
						{% else %}
							<form action={{ path('app_post_remrepost', {'id': post.id} )}} method="post">
								<input name="unrepost" id="unrepost" value="enlever le repost" type="submit">
							</form>
						{% endif %}
					</td>
					<td>
						<a href="{{ path('app_post_show', {'id': post.id}) }}">détails</a>
					</td>
					<td>
						<a href="{{ path('app_reply_new', {'id': post.id}) }}">répondre</a>
					</td>
					<td>Nombre de signalements :
						{{ post.countFlag }}
					</td>
					<td>
						{% if app.user and post not in app.user.flagPost %}
							<form action={{ path('app_post_addflag', {'id': post.id} )}} method="post">
								<input name="flag" id="flag" value="signaler" type="submit">
							</form>
						{% else %}
							<form action={{ path('app_post_unflag', {'id': post.id} )}} method="post">
								<input name="unflag" id="unflag" value="retirer le signalement" type="submit">
							</form>
						{% endif %}
					</td>
				</tr>
				<tr>
					<td>
						{% if is_granted('ROLE_ADMIN') or (app.user and post.creator and app.user.id == post.creator.id) %}
							<a href="{{ path('app_post_edit', {'id': post.id}) }}">modifier</a>
							{{ include('post/_delete_form.html.twig') }}
						{% endif %}
					</td>
				</tr>
			</article>
			<article>

				{% if post.replies|length > 0 %}
					<h3>Réponses</h3>
					{% for rep in post.replies %}
						<article>
							<tr>
								<td>Répondue le :
									{{ rep.createdAt ? rep.createdAt|date('Y-m-d H:i:s') : '' }}
									par :{{ rep.creator.userName }}</td>
								<td>{{ rep.content }}</td>

								<td>
									{% if rep.image %}
										<img src="{{ asset('uploads/replies/' ~ rep.image) }}" alt="Image de la reponse" style="max-width: 200px; max-height: 200px;">
									{% endif %}
								</td>
							</tr>
							<tr>
								<td>
									<a href="{{ path('app_reply_show', {'id': rep.id}) }}">détails</a>
								</td>
								<td>
									{% if is_granted('ROLE_ADMIN') or (app.user and rep.creator and app.user.id == rep.creator.id) %}
										<a href="{{ path('app_reply_edit', {'id': rep.id}) }}">modifier</a>
									{% endif %}
								</td>
								<td>
									Nombre de signalements :
									{{ rep.countFlag }}
								</td>
								<td>
									{% if app.user and rep not in app.user.flagReply %}
										<form action={{ path('app_reply_addflag', {'id': rep.id} )}} method="post">
											<input name="flag" id="flag" value="signaler" type="submit">
										</form>
									{% else %}
										<form action={{ path('app_reply_unflag', {'id': rep.id} )}} method="post">
											<input name="unflag" id="unflag" value="retirer le signalement" type="submit">
										</form>
									{% endif %}
								</td>
							</tr>
						</article>
					{% endfor %}
				{% endif %}
			</article>
		{% endfor %}
	</section>


{% endblock %}
