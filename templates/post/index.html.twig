{% extends 'base.html.twig' %}

{% block title %}Post index
{% endblock %}

{% block body %}
	<div class="page-stack-wide">
		<h1 class="section-title-lg">Liste des posts signales</h1>

		{% set has_flagged_posts = false %}
		{% for post in posts %}
			{% if post.countFlag > 0 %}
				{% set has_flagged_posts = true %}
			{% endif %}
		{% endfor %}

		{% if has_flagged_posts %}
			<div class="table-shell">
				<table class="table">
					<thead>
						<tr>
							<th>Auteur</th>
							<th>Titre</th>
							<th>Contenu</th>
							<th>Cree le</th>
							<th>Modifie le</th>
							<th>Reposts</th>
							<th>J'aime</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for post in posts %}
							{% if post.countFlag > 0 %}
								<tr>
									<td class="table-strong">{{ post.author }}</td>
									<td class="table-strong">{{ post.title }}</td>
									<td>{{ post.content }}</td>
									<td>{{ post.createdAt ? post.createdAt|date('Y-m-d H:i:s') : '' }}</td>
									<td>{{ post.updatedAt ? post.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
									<td>{{ post.countRepost }}</td>
									<td>{{ post.countLike }}</td>
									<td class="table-actions">
										<a class="table-link" href="{{ path('app_post_show', {'id': post.id}) }}">details</a>
										<a class="table-link" href="{{ path('app_reply_new', {'id': post.id}) }}">repondre</a>
										{% if is_granted('ROLE_ADMIN') or (app.user and post.creator and app.user.id == post.creator.id) %}
											<a class="table-link" href="{{ path('app_post_edit', {'id': post.id}) }}">modifier</a>
										{% endif %}
									</td>
								</tr>
							{% endif %}
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% else %}
			<p class="muted-text">aucun post n'a de signalement</p>
		{% endif %}
	</div>

{% endblock %}
