{% extends 'base.html.twig' %}

{% block title %}Post
{% endblock %}

{% block body %}
	<h1>Post</h1>

	<table class="table">
		<tbody>
			{# <tr>
																			<th>Id</th>
																			<td>{{ post.id }}</td>
																		</tr> #}
			<tr>
				<th>Author</th>
				<td>{{ post.author }}</td>
			</tr>
			<tr>
				<th>Title</th>
				<td>{{ post.title }}</td>
			</tr>
			<tr>
				<th>Content</th>
				<td>{{ post.content }}</td>
			</tr>
			<tr>
				<th>Image</th>
				<td>
					{% if post.image %}
						<img src="{{ asset('uploads/posts/' ~ post.image) }}" alt="Image du post {{ post.title }}" style="max-width: 250px; max-height: 250px;">
					{% else %}
						Aucune image
					{% endif %}
				</td>
			</tr>
			<tr>
				<th>Created_at</th>
				<td>{{ post.createdAt ? post.createdAt|date('Y-m-d H:i:s') : '' }}</td>
			</tr>
			<tr>
				<th>Updated_at</th>
				<td>{{ post.updatedAt ? post.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
			</tr>
			<tr>
				<th>Count_repost</th>
				<td>{{ post.countRepost }}</td>
			</tr>
			<tr>
				<th>Count_like</th>
				<td>{{ post.countLike }}</td>
			</tr>
			{# <tr>
																			<th>Status</th>
																			<td>{{ post.status }}</td>
																		</tr> #}
			<tr>
				<th>Count_flag</th>
				<td>{{ post.countFlag }}</td>
			</tr>

		</tbody>
	</table>

	<a href="{{ path('app_post_edit', {'id': post.id}) }}">edit post</a>

	{{ include('post/_delete_form.html.twig') }}

	<h2>Reply</h2>
	<table class="table">
		{% if replies|length > 0 %}
			{% for rep in replies %}
				<tr>
					<th>Content</th>
					<td>{{ rep.content }}</td>
				</tr>
				<tr>
					<th>Image</th>
					<td>
						{% if rep.image %}
							<img src="{{ asset('uploads/replies/' ~ rep.image) }}" alt="Image de la reponse" style="max-width: 200px; max-height: 200px;">
						{% else %}
							Aucune image
						{% endif %}
					</td>
				</tr>
				<tr>
					<th>Creator</th>
					<td>{{ rep.creator.userName }}</td>
				</tr>
				<tr>
					<th>Created_at</th>
					<td>{{ rep.createdAt ? rep.createdAt|date('Y-m-d H:i:s') : '' }}</td>
				</tr>
			{% endfor %}
		{% else %}
			<tr>
				<td>Il n'y a pas de replies</td>
			</tr>
		{% endif %}
	</table>
        <h2><a href="{{ path('app_reply_new', {'id': post.id}) }}">New Reply</a></h2>
        {# <a href="{{ path('app_reply_new', {'id': post.id}) }}">New Reply</a> #}
		{# {{ include('reply/_form.html.twig') }} #}
		<a href="{{ path('app_post_index') }}">back to list</a>


	{% endblock %}
